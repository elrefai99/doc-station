generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Project specific models
model User {
  id              Int        @id @default(autoincrement())
  fullname        String     @db.VarChar(255)
  email           String     @db.VarChar(255)
  password        String     @db.VarChar(255)
  username        String     @unique @db.VarChar(255)
  role            UserRole   @default(PATIENT)
  status          UserStatus @default(ACTIVE)
  avatar          String     @db.VarChar(255)
  Bio             String     @db.VarChar(255)
  code            String     @db.VarChar(255)
  phone           String     @unique @db.VarChar(255)
  address         String     @db.VarChar(255)
  city            String     @db.VarChar(255)
  state           String     @db.VarChar(255)
  zip             String     @db.VarChar(255)
  isVerified      Boolean    @default(false)
  isActive        Boolean    @default(true)
  isDeleted       Boolean    @default(false)
  isArchived      Boolean    @default(false)
  isSuspended     Boolean    @default(false)
  isLocked        Boolean    @default(false)
  isExpired       Boolean    @default(false)
  isExpiring      Boolean    @default(false)
  isExpiredSoon   Boolean    @default(false)
  updatePAssword  DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  otps            OTP[]
  patientBookings Booking[]  @relation("PatientBookings")
  doctorBookings  Booking[]  @relation("DoctorBookings")

  @@index([status])
  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model OTP {
  id     Int    @id @default(autoincrement())
  userId Int?
  otp    String @db.VarChar(255)
  expire String @db.VarChar(255)
  user   User?  @relation(fields: [userId], references: [id])
}

model Gallery {
  id        Int       @id @default(autoincrement())
  url       String
  productId Int?
  product   Products? @relation(fields: [productId], references: [id])
}

model Brands {
  id       Int        @id @default(autoincrement())
  title    String     @db.VarChar(255)
  products Products[]
}

model Products {
  id          Int     @id @default(autoincrement())
  title       String  @db.VarChar(255)
  slug        String  @unique @db.VarChar(255)
  description String  @db.Text
  content     String  @db.Text
  price       Decimal @db.Decimal(10, 2)

  brandId Int
  brand   Brands @relation(fields: [brandId], references: [id])

  image     Gallery[]
  tags      String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Blogs {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String   @db.Text
  content     String   @db.Text
  image       String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id        Int    @id @unique @default(autoincrement())
  patientId Int?
  dockerId  Int?
  date      String @db.VarChar(255)

  patient User? @relation("PatientBookings", fields: [patientId], references: [id])
  doctor  User? @relation("DoctorBookings", fields: [dockerId], references: [id])
}

// Project specific enums
enum UserRole {
  ADMIN
  PATIENT
  DOCTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  VERIFIED
  BANNED
  SUSPENDED
  DELETED
  ARCHIVED
}
