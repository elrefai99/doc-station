generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User ---------------------------------
enum Role {
  USER
  ADMIN
}

enum UserType {
  DOCTOR
  PATIENT
}

enum UserStatus {
  active
  inactive
  pending
  block
}

model User {
  id        Int        @id @unique @default(autoincrement())
  site_id   String     @unique
  fName     String
  lName     String
  username  String     @unique
  status    UserStatus @default(pending)
  email     String
  password  String
  code      String
  phone     String
  googleId  String?    @unique
  role      Role       @default(USER)
  userType  UserType
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  doctorProfiles     DoctorProfile[]
  notifications      notification[]
  blogs              Blogs[]
  products           Products[]
  orders             Order[]
  appointments       Appointment[]   @relation("patientAppointmet")
  doctorAppointments Appointment[]   @relation("doctorAppointment")

  @@index([username])
  @@index([email])
}

// Doctor Profile 
model DoctorProfile {
  id            Int      @id @unique @default(autoincrement())
  site_id       String   @unique
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id])
  specialty     String?
  bio           String?
  experience    Int?
  clinicName    String?  @db.VarChar(255)
  clinicPhone   String?  @db.VarChar(20)
  clinicAddress String?  @db.VarChar(500)
  latitude      Float?
  longitude     Float?
  education     String?  @db.VarChar(2000)
  priceInPerson Int      @default(0)
  priceOnline   Int      @default(0)
  ratingAvg     Float    @default(0)
  slotDuration  Int      @default(30) // minutes per appointment slot
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ─── Notification ─────────────────────────────────────────────────────────────
enum NotificationType {
  BOOKING
  PAYMENT
  MESSAGE
  REVIEW
  SYSTEM
  GENERAL
}

model notification {
  id        Int              @id @unique @default(autoincrement())
  userId    Int?
  type      NotificationType @default(GENERAL)
  title     String           @db.VarChar(255)
  content   String           @db.VarChar(1000)
  link      String?          @db.VarChar(500)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Gallery {
  id        Int      @id @unique @default(autoincrement())
  url       String   @db.VarChar(500)
  productId Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Products? @relation(fields: [productId], references: [id])
}

model Brands {
  id        Int      @id @unique @default(autoincrement())
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Products[]
}

model Blogs {
  id          Int      @id @default(autoincrement())
  authorId    Int?
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String   @db.VarChar(500)
  content     String
  image       String   @db.VarChar(500)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User? @relation(fields: [authorId], references: [id])
}

model Products {
  id          Int      @id @unique @default(autoincrement())
  adminId     Int?
  brandId     Int?
  title       String?  @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String?  @db.VarChar(500)
  content     String?  @db.VarChar(2000)
  price       Decimal? @db.Decimal(10, 2)
  stock       Int      @default(0)
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  image  Gallery[]
  brand  Brands?   @relation(fields: [brandId], references: [id])
  user   User?     @relation(fields: [adminId], references: [id])
  orders Order[]

  @@index([adminId])
  @@index([slug])
}

// ─── Order / Payment ──────────────────────────────────────────────────────────
enum OrderStatus {
  PENDING
  SUCCESS
  REFUNDED
  FAILED
}

enum OrderType {
  BOOKING
  PRODUCT
}

model Appointment {
  id        Int @id @unique @default(autoincrement())
  patientId Int
  doctorId  Int

  patient User?   @relation("patientAppointmet", fields: [patientId], references: [id])
  doctor  User?   @relation("doctorAppointment", fields: [doctorId], references: [id])
  orders  Order[]
}

model Order {
  id                   Int         @id @unique @default(autoincrement())
  userId               Int?
  appointmentId        Int?
  productId            Int?
  type                 OrderType   @default(BOOKING)
  status               OrderStatus @default(PENDING)
  amount               Int
  currency             String      @default("EGP") @db.VarChar(10)
  paymentGateway       String      @default("") @db.VarChar(50)
  paymentGatewayStatus String      @default("") @db.VarChar(50)
  transactionId        String      @default("") @db.VarChar(255)
  cardNumber           String      @default("") @db.VarChar(20)
  paymentMethod        String      @default("") @db.VarChar(50)
  paymentType          String      @default("") @db.VarChar(50)
  hmac                 String      @default("") @db.VarChar(500)
  gatewayCode          String      @default("") @db.VarChar(100)
  gatewayMessage       String      @default("") @db.VarChar(500)
  refundReason         String?     @db.VarChar(500)
  paidAt               DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  product     Products?    @relation(fields: [productId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([appointmentId])
  @@index([status])
  @@index([transactionId])
}
