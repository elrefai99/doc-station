generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int               @id @default(autoincrement())
  fullname         String            @db.VarChar(255)
  username         String            @unique @db.VarChar(255)
  email            String            @db.VarChar(255)
  password         String            @db.VarChar(255)
  code             String            @default("") @db.VarChar(255)
  phone            String            @default("") @db.VarChar(255)
  address          String            @default("") @db.VarChar(255)
  city             String            @default("") @db.VarChar(255)
  state            String            @default("") @db.VarChar(255)
  zip              String            @default("") @db.VarChar(255)
  role             UserRole          @default(PATIENT)
  status           UserStatus        @default(ACTIVE)
  isVerified       Boolean           @default(false)
  isActive         Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  isArchived       Boolean           @default(false)
  isSuspended      Boolean           @default(false)
  isLocked         Boolean           @default(false)
  isExpired        Boolean           @default(false)
  isExpiring       Boolean           @default(false)
  isExpiredSoon    Boolean           @default(false)
  updatePAssword   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  avatar           String            @default("") @db.VarChar(255)
  Bio              String            @default("") @db.VarChar(255)
  doctorBookings   Booking[]         @relation("DoctorBookings")
  patientBookings  Booking[]         @relation("PatientBookings")
  otps             OTP[]
  medicalHistories medical_history[]
  doctorProfiles   doctor_profile[]
  doctorOrders     Order[]           @relation("DoctorOrders")
  patientOrders    Order[]           @relation("PatientOrders")
  orders           Order[]
  notifications    notification[]
  RoomsSender      rooms[]           @relation("RoomsSender")
  RoomsReceiver    rooms[]           @relation("RoomsReceiver")
  dmChatSender     dmChat[]          @relation("dmChatSender")

  @@index([status])
  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model OTP {
  id        Int       @id @default(autoincrement())
  userId    Int?
  otp       Int
  expire    String    @db.VarChar(255)
  status    OTPStatus @default(PENDING)
  user      User?     @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

model medical_history {
  id          Int      @id @default(autoincrement())
  userId      Int
  start_date  String   @db.VarChar(255)
  images      String[] @db.VarChar(255)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
}

model doctor_profile {
  id            Int      @id @default(autoincrement())
  userId        Int
  address       Json
  governorateId Int
  cityId        Int
  timeStart     String   @db.VarChar(255)
  timeEnd       String   @db.VarChar(255)
  dateFrom      String   @db.VarChar(255)
  dateTo        String   @db.VarChar(255)
  price         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User?        @relation(fields: [userId], references: [id])
  governorate governorate? @relation(fields: [governorateId], references: [id])
  city        city?        @relation(fields: [cityId], references: [id])

  @@index([userId])
  @@index([governorateId])
  @@index([cityId])
}

model governorate {
  id                  Int              @id @default(autoincrement())
  number              Int
  governorate_name_ar String
  governorate_name_en String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  doctorProfiles      doctor_profile[]
  cities              city[]
}

model city {
  id                 Int      @id @default(autoincrement())
  number             Int
  governorate_number Int
  city_name_ar       String
  city_name_en       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  governorate governorate? @relation(fields: [governorate_number], references: [id])

  doctorProfiles doctor_profile[]
}

model Gallery {
  id        Int       @id @default(autoincrement())
  url       String
  productId Int?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  product   Products? @relation(fields: [productId], references: [id])
}

model Brands {
  id        Int        @id @default(autoincrement())
  title     String     @db.VarChar(255)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  products  Products[]
}

model Products {
  id          Int       @id @default(autoincrement())
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  description String
  content     String
  price       Decimal   @db.Decimal(10, 2)
  brandId     Int
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  image       Gallery[]
  brand       Brands    @relation(fields: [brandId], references: [id])
}

model Blogs {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  description String
  content     String
  image       String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id        Int           @id @unique @default(autoincrement())
  patientId Int?
  doctorId  Int?
  status    BookingStatus @default(PENDING)
  date      String        @db.VarChar(255)
  time      String        @db.VarChar(255)
  price     Int
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  doctor    User?         @relation("DoctorBookings", fields: [doctorId], references: [id])
  patient   User?         @relation("PatientBookings", fields: [patientId], references: [id])
  orders    Order[]
  rooms     rooms[]
}

model Order {
  id        Int         @id @unique @default(autoincrement())
  patientId Int?
  doctorId  Int?
  bookingId Int?
  productId Int?
  status    OrderStatus @default(PENDING)
  idBooking Boolean     @default(false)
  idProduct Boolean     @default(false)
  date      String      @db.VarChar(255)
  time      String      @db.VarChar(255)
  price     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  doctor  User?    @relation("DoctorOrders", fields: [doctorId], references: [id])
  patient User?    @relation("PatientOrders", fields: [patientId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])
  userId  Int?
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  status    String
  content   String
  link      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])
}

model rooms {
  id          Int      @id @default(autoincrement())
  senderID    Int
  receiverID  Int
  bookingId   Int?
  lastMassage String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sender     User?    @relation("RoomsSender", fields: [senderID], references: [id])
  receiver   User?    @relation("RoomsReceiver", fields: [receiverID], references: [id])
  booking    Booking? @relation(fields: [bookingId], references: [id])
  dmChatChat dmChat[] @relation("dmChatChat")
}

model dmChat {
  id            Int      @id @default(autoincrement())
  chatID        Int?
  senderID      Int?
  seen          Boolean  @default(false)
  message       String
  organicMessge String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sender User?  @relation("dmChatSender", fields: [senderID], references: [id])
  chat   rooms? @relation("dmChatChat", fields: [chatID], references: [id])
}

enum UserRole {
  ADMIN
  PATIENT
  DOCTOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  VERIFIED
  BANNED
  SUSPENDED
  DELETED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  PAYMENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  SUCCESS
  REFUNDED
  FAILED
}

enum OTPStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}
