{
  "name": "doc-station",
  "version": "1.2.1",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "dev": "concurrently \"NODE_ENV=development nodemon -L\" \"NODE_ENV=development npx ts-node ./src/Queue/worker.ts\"",
    "dev:windows": "concurrently \" nodemon -L\" \"npx ts-node ./src/Queue/worker.ts\"",
    "visualize": "hviz --type prisma --schema prisma/schema.prisma --port 4000",
    "build": "tsc",
    "start": "concurrently \"node ./dist/src/app.js\" \"node ./dist/src/Queue/worker.js\"",
    "test": "jest --detectOpenHandles --runInBand",
    "test:local": "NODE_ENV=development jest",
    "seed": "ts-node prisma/seeds/governorate.seed.ts",
    "seed:city": "ts-node prisma/seeds/city.seed.ts",
    "seed:all": "ts-node prisma/seeds/seed.ts",
    "taze:local": "npx taze -r",
    "taze:back": "npx taze major",
    "taze:update": "npx taze major -w",
    "taze:patch": "npx taze patch",
    "compress:ubuntu": "sudo zip -r project.zip ."
  },
  "prisma": {
    "seed": "ts-node prisma/seeds/seed.ts"
  },
