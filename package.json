{
  "name": "doc-station",
  "version": "0.1.1",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "dev": "concurrently \"NODE_ENV=development nodemon -L\" \"npx ts-node ./src/Queue/worker.ts\"",
    "dev:windows": "concurrently \" nodemon -L\" \"npx ts-node ./src/Queue/worker.ts\"",
    "dev:noWorker": "nodemon",
    "build": "tsc",
    "start": "concurrently \"node ./dist/app.js\" \"node ./dist/Queue/worker.js\"",
    "test": "jest --detectOpenHandles --runInBand",
    "test:local": "NODE_ENV=development jest",
    "taze:local": "npx taze -r",
    "taze:back": "npx taze major",
    "taze:update": "npx taze major -w",
    "taze:patch": "npx taze patch",
    "compress:ubuntu": "sudo zip -r project.zip ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^7.2.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-useragent": "^2.0.2",
    "fs-extra": "^11.3.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@mohamed-elrefai/tsconfigs": "^1.0.2",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/extension-accelerate": "^3.0.1",
    "@types/axios": "^0.14.4",
    "@types/bcrypt": "^6.0.0",
    "@types/concurrently": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "@types/express-useragent": "^1.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/helmet": "^4.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
